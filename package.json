{
  "name": "worker-sync-db",
  "version": "0.1.0",
  "description": "Offline-first IndexedDB for web apps: live multi-tab updates and sync to your own API (TypeScript, optional React hooks)",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "./dist/shared-worker/entry.js",
    "./dist/dedicated-worker/entry.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./shared-worker": {
      "types": "./dist/shared-worker/entry.d.ts",
      "import": "./dist/shared-worker/entry.js"
    },
    "./dedicated-worker": {
      "types": "./dist/dedicated-worker/entry.d.ts",
      "import": "./dist/dedicated-worker/entry.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "bench:e2e": "playwright test --config e2e/bench/playwright.config.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "pack:dry": "npm run build && npm pack --dry-run",
    "example:install": "npm ci --prefix examples/vite-react-todos",
    "example:dev": "npm run dev --prefix examples/vite-react-todos",
    "example:build": "npm run build --prefix examples/vite-react-todos",
    "example:preview": "npm run preview --prefix examples/vite-react-todos"
  },
  "dependencies": {
    "idb": "^8.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "typescript": ">=5"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "indexeddb",
    "sharedworker",
    "offline-first",
    "sync",
    "multi-tab",
    "typescript",
    "local-first",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/profyt/jubilant-journey.git"
  },
  "bugs": {
    "url": "https://github.com/profyt/jubilant-journey/issues"
  },
  "homepage": "https://github.com/profyt/jubilant-journey#readme",
  "author": "Dmitrii Novoselov",
  "license": "MIT"
}
